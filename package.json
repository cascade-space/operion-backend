{
  "name": "operion-backend",
  "version": "1.0.0",
  "description": "Multi-tenant Factory Management System Backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node -r ./tsconfig-paths-bootstrap.js dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "seed": "tsx src/scripts/seed.ts",
    "create-superadmin": "tsx src/scripts/create-superadmin.ts",
    "reset": "tsx src/scripts/reset-database.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:run": "tsx src/scripts/run-migrations.ts",
    "backup": "tsx src/scripts/backup-database.ts",
    "backup:restore": "tsx src/scripts/backup-database.ts --restore",
    "mark-absent": "node scripts/markAbsent.js",
    "test-backend": "tsx scripts/testBackend.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop operion-backend",
    "pm2:restart": "pm2 restart operion-backend",
    "pm2:logs": "pm2 logs operion-backend",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.490.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@google-cloud/storage": "^7.7.0",
    "@sentry/node": "^7.91.0",
    "@types/pdfkit": "^0.17.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.3",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "csurf": "^1.11.0",
    "isomorphic-dompurify": "^2.9.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.17.2",
    "sharp": "^0.33.0",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "ws": "^8.14.2",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.4.3",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/csurf": "^1.11.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "factory",
    "management",
    "multi-tenant",
    "production",
    "attendance",
    "typescript"
  ],
  "author": "Operion Team",
  "license": "MIT"
}

# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to version control

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000
WS_PORT=3001
LOG_LEVEL=info

# ============================================
# MONGODB CONFIGURATION
# ============================================
# ⚠️ REQUIRED: Use MongoDB Atlas or secure MongoDB instance
# 
# ⚠️ IMPORTANT: Replace the placeholder values below with your actual MongoDB connection string!
#
# For MongoDB Atlas (Recommended for Production):
# 1. Go to MongoDB Atlas → Database → Connect → Connect your application
# 2. Copy the connection string (should look like mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/...)
# 3. Replace <password> with your actual password
# 4. Replace <database> with your database name (e.g., operion_prod)
# Example: mongodb+srv://myuser:mypassword@cluster0.abc123.mongodb.net/operion_prod?retryWrites=true&w=majority
#MONGODB_URI_PROD=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.XXXXX.mongodb.net/operion_prod?retryWrites=true&w=majority
#
# For Self-Hosted MongoDB (on same EC2 instance):
# Example: mongodb://username:password@localhost:27017/operion_prod?authSource=operion_prod
# Or without authentication: mongodb://localhost:27017/operion_prod
#MONGODB_URI_PROD=mongodb://localhost:27017/operion_prod
#
# ⚠️ DO NOT USE THE PLACEHOLDER BELOW - Replace it with your actual connection string!
# The placeholder "cluster.mongodb.net" will NOT work - you need your actual cluster hostname!
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/operion_prod?retryWrites=true&w=majority

# ============================================
# REDIS CONFIGURATION
# ============================================
# ⚠️ RECOMMENDED: Use AWS ElastiCache or managed Redis
REDIS_URL=redis://your-redis-instance.cache.amazonaws.com:6379
# Or use AWS ElastiCache endpoint
REDIS_REQUIRED=true
# Set to true in production if Redis is critical

# ============================================
# JWT CONFIGURATION
# ============================================
# ⚠️ CRITICAL: Generate strong secrets using:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

JWT_SECRET=CHANGE_ME_GENERATE_32_CHAR_OR_LONGER_SECRET
# ⚠️ MUST be at least 32 characters
# ⚠️ MUST be a strong random string
# ⚠️ NEVER use default values

JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_DIFFERENT_32_CHAR_SECRET
# ⚠️ MUST be different from JWT_SECRET
# ⚠️ MUST be at least 32 characters

JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=365d

# ============================================
# AWS S3 CONFIGURATION (REQUIRED FOR FILE STORAGE)
# ============================================
STORAGE_TYPE=s3
AWS_S3_BUCKET=operion-production-files
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Optional: CloudFront CDN URL for faster file delivery
STORAGE_BASE_URL=https://d1234567890.cloudfront.net

# ============================================
# DATABASE BACKUP CONFIGURATION
# ============================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=operion-backups-prod
BACKUP_S3_REGION=us-east-1

# ============================================
# CORS CONFIGURATION
# ============================================
# ⚠️ REQUIRED: Set to your production domain(s)
# ⚠️ CRITICAL: This MUST be configured or your frontend will be blocked
CORS_ORIGINS=https://app.yourdomain.com,https://your-app.vercel.app
# Comma-separated list of allowed origins (no spaces after commas)
# 
# For Vercel deployment, include:
# - Your Vercel default URL: https://your-app.vercel.app
# - Your custom domain (if configured): https://app.yourdomain.com
#
# Examples:
# - Single origin: https://app.yourdomain.com
# - Multiple origins: https://app.yourdomain.com,https://admin.yourdomain.com,https://your-app.vercel.app
# - With subdomains: https://app.yourdomain.com,https://api.yourdomain.com
#
# ⚠️ IMPORTANT:
# - Use HTTPS in production (not HTTP)
# - Include all variations of your domain (with/without www, subdomains)
# - No trailing slashes
# - No spaces between commas

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
# Or use AWS SES, Mailgun, etc.

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# MONITORING (Optional)
# ============================================
# Sentry DSN for error tracking (free tier available)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# AWS CloudWatch Log Group (optional)
CLOUDWATCH_LOG_GROUP=operion-backend-prod

# ============================================
# SECURITY NOTES
# ============================================
# 1. All secrets should be stored in AWS Secrets Manager or Parameter Store
# 2. Use IAM roles for AWS service access when possible (instead of access keys)
# 3. Enable MongoDB Atlas network access restrictions
# 4. Configure security groups to restrict access
# 5. Use VPC for internal service communication
# 6. Enable AWS WAF for DDoS protection
# 7. Regularly rotate secrets and access keys


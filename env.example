# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
# Server port (Required)
# Default: 3000

WS_PORT=3001
# WebSocket server port (Required)
# Default: 3001

NODE_ENV=development
# Node environment (Required)
# Options: development, production, test
# Default: development

LOG_LEVEL=info
# Logging level (Optional)
# Options: dev, combined, tiny, short, common
# Default: info

# ============================================
# MONGODB CONFIGURATION
# ============================================
MONGODB_URI=mongodb://localhost:27017/operion
# MongoDB connection URI for development (Required)
# Format: mongodb://[username:password@]host[:port][/database]

MONGODB_URI_PROD=mongodb://localhost:27017/operion_prod
# MongoDB connection URI for production (Required in production)
# Used when NODE_ENV=production
# Recommended: Use MongoDB Atlas connection string for production

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
# Redis connection URL (Optional but recommended)
# Format: redis://[password@]host[:port]
# Alternative: Use REDIS_HOST and REDIS_PORT below

REDIS_HOST=localhost
# Redis host (Optional if REDIS_URL is provided)
# Default: localhost

REDIS_PORT=6379
# Redis port (Optional if REDIS_URL is provided)
# Default: 6379

REDIS_PASSWORD=
# Redis password (Optional)
# Leave empty if no password required

REDIS_CLUSTER_MODE=false
# Redis cluster mode (Optional)
# Default: false

REDIS_REQUIRED=false
# Whether Redis is required for the application to start (Optional)
# Set to 'true' if Redis is critical (e.g., production with caching)
# Default: false (app will run without Redis in dev mode)

# ============================================
# JWT CONFIGURATION (REQUIRED)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT access token secret (Required)
# 
# ⚠️ SECURITY WARNING ⚠️
# - MUST be at least 32 characters in production
# - MUST NOT use default values in production
# - MUST be a strong random string
# 
# Generate a strong secret:
#   openssl rand -base64 32
#   OR
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 
# For production, see .env.production.example for secure configuration
# NEVER commit production secrets to version control

JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
# JWT refresh token secret (Required)
# 
# ⚠️ SECURITY WARNING ⚠️
# - MUST be at least 32 characters in production
# - MUST be DIFFERENT from JWT_SECRET
# - MUST NOT use default values in production
# - MUST be a strong random string
# 
# Generate a DIFFERENT strong secret:
#   openssl rand -base64 32
# 
# For production, see .env.production.example for secure configuration
# NEVER commit production secrets to version control

JWT_EXPIRES_IN=30d
# JWT access token expiration (Optional)
# Format: 15m, 1h, 24h, 30d, etc.
# Default: 30d (30 days)

JWT_REFRESH_EXPIRES_IN=365d
# JWT refresh token expiration (Optional)
# Format: 7d, 30d, 365d, etc.
# Default: 365d (1 year for persistent login)

# ============================================
# CACHING CONFIGURATION
# ============================================
CACHE_DEFAULT_TTL=300
# Default cache TTL in seconds (Optional)
# Default: 300 (5 minutes)

CACHE_ENABLED=true
# Enable/disable caching (Optional)
# Default: true

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# Required for password reset functionality
SMTP_HOST=smtp.gmail.com
# SMTP server host (Optional)

SMTP_PORT=587
# SMTP server port (Optional)
# Default: 587

SMTP_USER=your-email@gmail.com
# SMTP username (Optional)

SMTP_PASS=your-app-password
# SMTP password or app password (Optional)
# For Gmail, use app-specific password

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
UPLOAD_PATH=./uploads
# Local storage path for uploads (Optional)
# Default: ./uploads
# Only used when STORAGE_TYPE=local

MAX_FILE_SIZE=5242880
# Maximum file size in bytes (Optional)
# Default: 5242880 (5MB)

STORAGE_TYPE=local
# Storage type (Required)
# Options: local, s3, gcs
# Default: local
# - local: Files stored on local filesystem
# - s3: Files stored in AWS S3
# - gcs: Files stored in Google Cloud Storage

ALLOWED_MIME_TYPES=image/jpeg,image/png,image/jpg,image/webp
# Comma-separated list of allowed MIME types (Optional)
# Default: image/jpeg,image/png,image/jpg,image/webp

# ============================================
# AWS S3 CONFIGURATION
# Required when STORAGE_TYPE=s3
# ============================================
AWS_S3_BUCKET=
# S3 bucket name (Required when STORAGE_TYPE=s3)

AWS_S3_REGION=us-east-1
# AWS region (Required when STORAGE_TYPE=s3)
# Default: us-east-1

AWS_ACCESS_KEY_ID=
# AWS access key ID (Required when STORAGE_TYPE=s3)
# Get from AWS IAM console

AWS_SECRET_ACCESS_KEY=
# AWS secret access key (Required when STORAGE_TYPE=s3)
# Get from AWS IAM console
# NEVER commit this to version control

STORAGE_BASE_URL=
# Base URL for file access (Optional)
# If not provided, will use bucket public URL or CDN URL
# Example: https://cdn.example.com

# ============================================
# GOOGLE CLOUD STORAGE CONFIGURATION
# Required when STORAGE_TYPE=gcs
# ============================================
GCS_BUCKET=
# GCS bucket name (Required when STORAGE_TYPE=gcs)

GCS_PROJECT_ID=
# Google Cloud project ID (Required when STORAGE_TYPE=gcs)

GCS_KEYFILE=
# Path to GCS service account keyfile (Optional)
# Can also use GOOGLE_APPLICATION_CREDENTIALS env var

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================
RATE_LIMIT_WINDOW_MS=900000
# Rate limit window in milliseconds (Optional)
# Default: 900000 (15 minutes)

RATE_LIMIT_MAX_REQUESTS=500
# Maximum requests per window (Optional)
# Default: 500 (increased from 100 for better user experience)

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:4173
# Comma-separated list of allowed CORS origins (Required in production)
# In development, defaults to localhost origins
# In production, MUST be explicitly set
# Example: https://app.example.com,https://admin.example.com

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
WS_MAX_CONNECTIONS=50
# Maximum concurrent WebSocket connections (Optional)
# Default: 50 (optimized for t2.micro with 1GB RAM)
# Each connection uses ~1-2MB memory

WS_MESSAGE_RATE_LIMIT=60
# Maximum messages per minute per WebSocket connection (Optional)
# Default: 60 messages per minute per connection
# Prevents message flooding attacks

# ============================================
# GEOFENCING CONFIGURATION
# ============================================
DEFAULT_GEOFENCE_RADIUS=100
# Default geofence radius in meters (Optional)
# Default: 100

# ============================================
# DATABASE BACKUP CONFIGURATION
# ============================================
BACKUP_DIR=./backups
# Local directory for storing backups (Optional)
# Default: ./backups

BACKUP_RETENTION_DAYS=30
# Number of days to retain backups (Optional)
# Default: 30

BACKUP_S3_BUCKET=
# S3 bucket for storing backups (Optional but recommended for production)
# If not set, backups are stored locally only

BACKUP_S3_REGION=us-east-1
# AWS region for backup bucket (Optional)
# Default: us-east-1 or AWS_S3_REGION if set